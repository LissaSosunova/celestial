    "/purchases": {
      "get": {
        "summary": "Получить историю покупок текущего пользователя",
        "tags": ["Purchases"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Успешный ответ",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PurchaseInfo"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Создать новую покупку",
        "tags": ["Purchases"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/PersonalNatalPurchase"
                  },
                  {
                    "$ref": "#/components/schemas/ChildNatalPurchase"
                  },
                  {
                    "$ref": "#/components/schemas/ForecastPurchase"
                  },
                  {
                    "$ref": "#/components/schemas/SynastryPurchase"
                  }
                ],
                "discriminator": {
                  "propertyName": "packageSlug"
                }
              },
              "examples": {
                "personalNatal": {
                  "summary": "Персональная натальная карта для себя",
                  "value": {
                    "packageSlug": "personal_natal",
                    "typeOfPurchase": "price",
                    "agreeToTerms": true,
                    "personSelectionType": "self"
                  }
                },
                "childNatal": {
                  "summary": "Натальная карта ребенка",
                  "value": {
                    "packageSlug": "child_natal",
                    "typeOfPurchase": "price",
                    "agreeToTerms": true,
                    "personSelectionType": "new",
                    "person": {
                      "name": "Анна",
                      "relation": {
                        "name": "child"
                      },
                      "birthDate": "2018-06-12",
                      "birthTime": "08:45:00",
                      "birthLocation": {
                        "country": "Украина",
                        "city": "Львов",
                        "timeZone": "Europe/Kiev"
                      }
                    }
                  }
                },
                "forecast": {
                  "summary": "Прогноз на 6 месяцев",
                  "value": {
                    "packageSlug": "forecast_6m",
                    "typeOfPurchase": "price",
                    "agreeToTerms": true,
                    "forecastTarget": "self",
                    "startDate": "2024-01-15"
                  }
                },
                "synastry": {
                  "summary": "Синастрия для пары",
                  "value": {
                    "packageSlug": "synastry",
                    "typeOfPurchase": "price",
                    "agreeToTerms": true,
                    "relationType": "relationship",
                    "firstPerson": {
                      "name": "Иван",
                      "birthDate": "1990-05-15",
                      "birthTime": "14:30:00",
                      "birthLocation": {
                        "country": "Украина",
                        "city": "Киев",
                        "timeZone": "Europe/Kiev"
                      }
                    },
                    "secondPerson": {
                      "name": "Мария",
                      "birthDate": "1992-08-20",
                      "birthTime": "08:45:00",
                      "birthLocation": {
                        "country": "Украина",
                        "city": "Одесса",
                        "timeZone": "Europe/Kiev"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Покупка успешно создана",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PurchaseInfo"
                }
              }
            }
          },
          "400": {
            "description": "Неверные данные запроса",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Не авторизован"
          }
        }
      }
    }
